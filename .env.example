APP_NAME="Autobedrijf Rijswijk"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Merk-/contactgegevens (zie config/brand.php). Vul de echte waarden in vóór livegang.
BRAND_PHONE="085 130 40 58"
BRAND_PHONE_HREF="+31851304058"
BRAND_MOBILE="06 4467 48 48"
BRAND_MOBILE_HREF="+31644674848"
BRAND_WHATSAPP="31611565177"
BRAND_EMAIL="info@autobedrijfrijswijk.nl"
BRAND_ADDRESS="Poldermeesterstraat 16, 2288 GV Rijswijk"
BRAND_CITY="Rijswijk"
# Echte Google-reviewscore + -aantal + de exacte review-URL van de zaak:
BRAND_REVIEW_RATING=4.7
BRAND_REVIEW_COUNT=227
BRAND_REVIEW_URL=
# Indicatieve financial-lease-rente (nominaal %):
BRAND_FINANCE_RATE=7.9

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────
# Maak eerst een lege MySQL/MariaDB-database aan met de naam hieronder
# (bv. via phpMyAdmin in XAMPP, of: mysql -u root -e "CREATE DATABASE garagesite").
# XAMPP-standaard: gebruiker 'root' zonder wachtwoord.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=garagesite
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
